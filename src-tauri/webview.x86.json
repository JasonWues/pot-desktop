{
    "app": {
        "trayIcon": {
            "id": "pot",
            "iconPath": "icons/icon.ico",
            "iconAsTemplate": true,
            "showMenuOnLeftClick": false
        }
    },
    "bundle": {
        "licenseFile": "../LICENSE",
        "windows": {
            "certificateThumbprint": null,
            "digestAlgorithm": "sha256",
            "timestampUrl": "",
            "webviewInstallMode": {
                "type": "fixedRuntime",
                "path": "./Microsoft.WebView2.FixedVersionRuntime.109.0.1518.78.x86/"
            },
            "nsis": {
                "displayLanguageSelector": true,
                "installerIcon": "icons/icon.ico",
                "installMode": "perMachine",
                "languages": [
                    "SimpChinese",
                    "TradChinese",
                    "English"
                ]
            }
        }
    },
    "plugins": {
        "updater": {
            "endpoints": [
                "https://github.com/JasonWues/pot-desktop/releases/download/updater/update-fix-runtime.json"
            ]
        }
    }
}
