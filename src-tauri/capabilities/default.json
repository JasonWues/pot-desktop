{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Permissions used by every Gloss window",
    "windows": ["*"],
    "permissions": [
        "core:default",
        "core:window:allow-close",
        "core:window:allow-hide",
        "core:window:allow-show",
        "core:window:allow-start-dragging",
        "core:window:allow-set-focus",
        "core:window:allow-set-always-on-top",
        "core:window:allow-set-resizable",
        "core:window:allow-maximize",
        "core:window:allow-unmaximize",
        "core:window:allow-minimize",
        "core:window:allow-set-size",
        "core:window:allow-set-position",
        "core:window:allow-center",
        "core:webview:allow-internal-toggle-devtools",
        "log:default",
        "store:default",
        "os:default",
        "process:allow-restart",
        "process:allow-exit",
        "updater:default",
        "notification:default",
        "clipboard-manager:allow-write-text",
        "clipboard-manager:allow-read-text",
        "dialog:allow-open",
        "dialog:allow-save",
        "shell:allow-open",
        {
            "identifier": "opener:allow-open-path",
            "allow": [
                { "path": "$APPLOG" },
                { "path": "$APPLOG/**" },
                { "path": "$APPCONFIG" },
                { "path": "$APPCONFIG/**" }
            ]
        },
        "autostart:allow-enable",
        "autostart:allow-disable",
        "autostart:allow-is-enabled",
        "global-shortcut:allow-register",
        "global-shortcut:allow-unregister",
        "global-shortcut:allow-unregister-all",
        "global-shortcut:allow-is-registered",
        "sql:allow-load",
        "sql:allow-close",
        "sql:allow-execute",
        "sql:allow-select",
        "fs:allow-exists",
        "fs:allow-read-dir",
        "fs:allow-read-file",
        "fs:allow-read-text-file",
        "fs:allow-mkdir",
        "fs:allow-remove",
        "fs:allow-watch",
        {
            "identifier": "fs:scope",
            "allow": [
                { "path": "$APPCONFIG" },
                { "path": "$APPCONFIG/**" },
                { "path": "$APPCACHE" },
                { "path": "$APPCACHE/**" }
            ]
        },
        {
            "_comment": [
                "`*:*`, not `*`. These are URLPatterns, and a pattern that leaves the port",
                "segment out matches only the protocol's DEFAULT port -- so `http://*` allowed",
                "example.com but rejected 127.0.0.1:60828 with `url not allowed on the",
                "configured scope`. That silently broke everything Gloss talks to on a port of",
                "its own: the Recognize window's translate button, which POSTs to the local",
                "server; the Anki collection service on 8765; and any service a user points at",
                "a self-hosted endpoint. The path segment does default to a wildcard, which is",
                "why the other 36 services never noticed.",
                "",
                "The intent was always 'any http(s) URL' -- Gloss exists to reach whatever",
                "endpoint the user configured -- so this says that."
            ],
            "identifier": "http:default",
            "allow": [{ "url": "http://*:*" }, { "url": "https://*:*" }]
        },
        "mcp-bridge:default"
    ]
}
